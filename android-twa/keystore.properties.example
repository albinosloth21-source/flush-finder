# Copy to android-twa/keystore.properties (gitignored).
# storeFile must point at the upload keystore, preferably outside this repo.
# Never commit the real file, the .jks, or these passwords.
storeFile=/absolute/path/outside/this/repo/flush-finder-upload.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=flushfinder
keyPassword=REPLACE_WITH_KEY_PASSWORD
